---
const navLinks = [
  { name: 'Inicio', href: '/' },
  { name: 'Productos', href: '/productos' },
  { name: 'Proceso', href: '/proceso' },
  { name: 'Sostenibilidad', href: '/sostenibilidad' },
  { name: 'Fundo', href: '/fundo' },
  { name: 'Noticias', href: '/noticias' },
  { name: 'Nosotros', href: '/nosotros' }
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHomePage = currentPath === '/';
function isActive(path: string) {
  if (path === '/') return currentPath === '/';
  return currentPath.startsWith(path);
}
---

<header id="main-navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-700 ease-out" data-home={isHomePage ? 'true' : 'false'}>
  <nav class="relative w-full">
    <div
      class:list={[
        "absolute inset-0 transition-all duration-700 nav-bg",
        isHomePage
          ? "bg-transparent shadow-none backdrop-blur-none"
          : "bg-warm-white/95 shadow-md shadow-navy-900/5 backdrop-blur-md"
      ]}
    ></div>

    <div class="relative w-full px-4 sm:px-6 lg:px-8 2xl:px-12">
      <div class:list={[
        "flex items-center justify-between transition-all duration-700 nav-height",
        isHomePage ? "h-20 xl:h-[88px]" : "h-16 md:h-[72px] xl:h-20"
      ]}>
        <a href="/" class="flex items-center gap-3 md:gap-4 group min-w-0 shrink-0">
          <img
            src="/images/logo-agn.png"
            alt="Agro Norte Corp"
            class="h-10 md:h-11 xl:h-12 w-auto object-contain rounded-lg shadow-md shadow-navy-900/10 transition-transform duration-500 group-hover:scale-105 bg-white shrink-0"
            width="48"
            height="48"
          />
          <div class="flex items-center min-w-0">
            <span class:list={[
              "font-brand text-base sm:text-lg md:text-xl xl:text-[1.35rem] font-extrabold transition-colors duration-700 tracking-[-0.02em] leading-none whitespace-nowrap nav-text-logo",
              isHomePage ? "text-white" : "text-navy-900"
            ]}>
              AGRO NORTE<span class:list={[
                "nav-text-sub",
                isHomePage ? "text-olive-300" : "text-olive-700"
              ]}> CORP</span>
            </span>
          </div>
        </a>

        <ul class="hidden lg:flex items-center justify-center gap-0.5 xl:gap-1 flex-1 mx-4 2xl:mx-8">
          {navLinks.map((link) => (
            <li class="shrink-0">
              <a
                href={link.href}
                data-active={isActive(link.href) ? 'true' : 'false'}
                class:list={[
                  "nav-link relative inline-flex px-3 2xl:px-4 py-2.5 text-[12.5px] xl:text-sm font-semibold uppercase tracking-[0.12em] transition-all duration-500 rounded-xl",
                  isHomePage
                    ? (isActive(link.href) ? "text-olive-300 bg-white/10" : "text-white/90 hover:text-white hover:bg-white/10")
                    : (isActive(link.href) ? "text-olive-700 bg-olive-50" : "text-navy-800/80 hover:text-olive-700 hover:bg-olive-50/50")
                ]}
              >
                {link.name}
                <span
                  class:list={[
                    "absolute bottom-1.5 left-1/2 -translate-x-1/2 h-[2.5px] rounded-full transition-all duration-500",
                    isHomePage && isActive(link.href) ? "w-8 bg-olive-300" : isActive(link.href) ? "w-8 bg-olive-600" : "w-0 bg-olive-600 hover:w-8"
                  ]}
                ></span>
              </a>
            </li>
          ))}
        </ul>

        <div class="hidden lg:flex items-center gap-2 xl:gap-3 shrink-0">
          <a
            href="https://wa.me/51987654321"
            target="_blank"
            rel="noopener"
            class:list={[
              "nav-whatsapp hidden xl:inline-flex items-center justify-center w-10 h-10 rounded-full text-white transition-all duration-500 hover:scale-110 hover:shadow-lg hover:shadow-[#25D366]/30",
              isHomePage ? "bg-white/15 border border-white/25" : "bg-[#25D366]"
            ]}
            aria-label="WhatsApp"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </a>
          <a
            href="/contacto"
            class:list={[
              "nav-cta flex items-center gap-2 px-4 xl:px-6 py-2.5 xl:py-3 rounded-xl text-[12px] xl:text-xs font-bold uppercase tracking-[0.14em] transition-all duration-500 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-olive-900/30 shadow-md shadow-olive-900/15",
              isHomePage
                ? "bg-white hover:bg-olive-50 text-olive-800 hover:text-olive-900"
                : "bg-olive-700 hover:bg-olive-800 text-white"
            ]}
          >
            <svg class="w-4 h-4 xl:w-[18px] xl:h-[18px] shrink-0" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span class="whitespace-nowrap">Contáctanos</span>
          </a>
        </div>

          <button id="mobile-menu-btn" class:list={[
          "lg:hidden p-2 transition-colors duration-700",
          isHomePage ? "text-white" : "text-navy-900"
        ]} aria-label="Abrir menú">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="lg:hidden fixed inset-x-0 top-0 h-screen bg-warm-white z-40 translate-x-full transition-transform duration-700 ease-out flex flex-col">
      <div class="flex items-center justify-between h-20 px-5 border-b border-navy-900/10">
        <a href="/" class="flex items-center gap-3">
          <img
            src="/images/logo-agn.png"
            alt="Agro Norte Corp"
            class="h-10 w-auto object-contain rounded-lg bg-white shadow-sm shrink-0"
            width="40"
            height="40"
          />
          <span class="font-brand text-lg sm:text-xl font-extrabold text-navy-900 whitespace-nowrap tracking-[-0.02em]">
            AGRO NORTE<span class="text-olive-700"> CORP</span>
          </span>
        </a>
        <button id="close-menu-btn" class="p-2 text-navy-900" aria-label="Cerrar menú">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div class="flex-1 flex flex-col px-5 py-8 gap-1 overflow-y-auto">
        {navLinks.map((link, i) => (
          <a
            href={link.href}
            class:list={[
              "mobile-link flex items-center justify-between py-4 px-4 rounded-xl transition-all duration-300 text-lg font-bold uppercase tracking-wider",
              isActive(link.href)
                ? "bg-olive-50 text-olive-700"
                : "text-navy-800 hover:bg-olive-50/60 hover:text-olive-700"
            ]}
            style={`animation-delay: ${i * 50}ms`}
          >
            <span>{link.name}</span>
            <svg class="w-5 h-5 opacity-50" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ))}
        <div class="mt-6 space-y-3 pt-6 border-t border-navy-900/10">
          <a href="https://wa.me/51987654321" target="_blank" rel="noopener" class="flex items-center gap-3 justify-center px-6 py-4 rounded-xl bg-[#25D366] text-white font-bold uppercase tracking-wider hover:bg-[#1ebe5b] transition-colors">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            WhatsApp
          </a>
          <a href="/contacto" class="flex items-center gap-3 justify-center btn-primary w-full text-center">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            Contáctanos
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  const navbar = document.getElementById('main-navbar');
  const navBg = navbar?.querySelector('.nav-bg');
  const navHeight = navbar?.querySelector('.nav-height');
  const navLinksEls = navbar?.querySelectorAll('.nav-link');
  const navTextLogo = navbar?.querySelectorAll('.nav-text-logo');
  const navTextSub = navbar?.querySelectorAll('.nav-text-sub');
  const navCta = navbar?.querySelector('.nav-cta');
  const navWhats = navbar?.querySelector('.nav-whatsapp');
  const isHome = navbar?.dataset.home === 'true';
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const closeMenuBtn = document.getElementById('close-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = mobileMenu?.querySelectorAll('.mobile-link');

  function updateNavbar() {
    const scrolled = window.scrollY > 40;
    const applyHeroStyle = isHome && !scrolled;

    if (navBg) {
      const el = navBg as HTMLElement;
      el.classList.toggle('bg-transparent', applyHeroStyle);
      el.classList.toggle('bg-warm-white/95', !applyHeroStyle);
      el.classList.toggle('shadow-none', applyHeroStyle);
      el.classList.toggle('shadow-md', !applyHeroStyle);
      el.classList.toggle('shadow-navy-900/5', !applyHeroStyle);
      el.classList.toggle('backdrop-blur-none', applyHeroStyle);
      el.classList.toggle('backdrop-blur-md', !applyHeroStyle);
    }

    if (navHeight) {
      navHeight.classList.toggle('h-20', applyHeroStyle);
      navHeight.classList.toggle('xl:h-[88px]', applyHeroStyle);
      navHeight.classList.toggle('h-16', !applyHeroStyle);
      navHeight.classList.toggle('md:h-[72px]', !applyHeroStyle);
      navHeight.classList.toggle('xl:h-20', !applyHeroStyle);
    }

    navLinksEls?.forEach(l => {
      const el = l as HTMLElement;
      const active = el.dataset.active === 'true';
      el.classList.remove(
        'text-navy-800/80', 'hover:text-olive-700', 'hover:bg-olive-50/50', 'bg-olive-50', 'text-olive-700',
        'text-white/90', 'hover:text-white', 'hover:bg-white/10', 'text-olive-300', 'bg-white/10'
      );
      if (applyHeroStyle) {
        if (active) el.classList.add('text-olive-300', 'bg-white/10');
        else el.classList.add('text-white/90', 'hover:text-white', 'hover:bg-white/10');
      } else {
        if (active) el.classList.add('bg-olive-50', 'text-olive-700');
        else el.classList.add('text-navy-800/80', 'hover:text-olive-700', 'hover:bg-olive-50/50');
      }
      const underline = el.querySelector('span');
      if (underline) {
        underline.classList.toggle('bg-olive-300', applyHeroStyle && active);
        underline.classList.toggle('bg-olive-600', !(applyHeroStyle && active));
      }
    });

    navTextLogo?.forEach(l => {
      (l as HTMLElement).classList.toggle('text-navy-900', !applyHeroStyle);
      (l as HTMLElement).classList.toggle('text-white', applyHeroStyle);
    });
    navTextSub?.forEach(l => {
      (l as HTMLElement).classList.toggle('text-olive-700', !applyHeroStyle);
      (l as HTMLElement).classList.toggle('text-olive-300', applyHeroStyle);
    });

    if (navCta) {
      const el = navCta as HTMLElement;
      el.classList.toggle('bg-white', applyHeroStyle);
      el.classList.toggle('hover:bg-olive-50', applyHeroStyle);
      el.classList.toggle('text-olive-800', applyHeroStyle);
      el.classList.toggle('hover:text-olive-900', applyHeroStyle);
      el.classList.toggle('bg-olive-700', !applyHeroStyle);
      el.classList.toggle('hover:bg-olive-800', !applyHeroStyle);
      el.classList.toggle('text-white', !applyHeroStyle);
    }
    if (navWhats) {
      const el = navWhats as HTMLElement;
      el.classList.toggle('bg-white/15', applyHeroStyle);
      el.classList.toggle('border', applyHeroStyle);
      el.classList.toggle('border-white/25', applyHeroStyle);
      el.classList.toggle('bg-[#25D366]', !applyHeroStyle);
    }
  }

  updateNavbar();
  window.addEventListener('scroll', updateNavbar, { passive: true });
  window.addEventListener('load', updateNavbar);
  window.addEventListener('resize', updateNavbar);

  mobileMenuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.remove('translate-x-full');
    document.body.style.overflow = 'hidden';
    mobileLinks?.forEach(l => (l as HTMLElement).classList.add('animate-fade-in-right'));
  });

  function closeMenu() {
    mobileMenu?.classList.add('translate-x-full');
    document.body.style.overflow = '';
  }

  closeMenuBtn?.addEventListener('click', closeMenu);
  mobileLinks?.forEach(l => l.addEventListener('click', closeMenu));
</script>
