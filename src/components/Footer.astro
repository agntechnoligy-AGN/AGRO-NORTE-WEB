---
import { resolveImages } from '../lib/media';
const media = await resolveImages(['logo']);
const logoSrc = media.logo;

const companyInfo = {
  name: 'Agro Norte Corp',
  email: 'informes@agronortecorp.pe',
  phone: '+51 987 654 321',
  address: 'Fundo Agro Norte, La Libertad, Perú',
  social: {
    facebook: '#',
    instagram: '#',
    linkedin: '#'
  }
};
---

<footer class="relative bg-navy-950 text-white overflow-hidden">
  <div class="absolute inset-0 pointer-events-none opacity-[0.04]">
    <div class="absolute -top-40 -right-40 w-[500px] h-[500px] rounded-full bg-olive-500 blur-3xl"></div>
  </div>

  <section class="relative border-b border-white/10">
    <div class="max-w-7xl mx-auto px-5 md:px-8 lg:px-12 py-20 md:py-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div class="reveal">
          <span class="section-label !text-olive-400">Hablemos</span>
          <h2 class="font-display text-3xl md:text-5xl font-semibold mb-6 text-balance">
            ¿Quieres conocer más sobre <span class="text-olive-400">Agro Norte Corp</span>?
          </h2>
          <p class="text-white/70 text-lg mb-10 max-w-xl font-light leading-relaxed">
            Estamos listos para conversar contigo. Contáctanos y descubre cómo llevamos la mejor fruta de nuestros campos hasta tu mesa.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="/contacto" class="btn-primary !bg-olive-600 hover:!bg-olive-500">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              Contáctanos
            </a>
            <a href="https://wa.me/51987654321" target="_blank" rel="noopener" class="flex items-center gap-2 px-7 py-3.5 bg-[#25D366] text-white font-medium text-sm uppercase tracking-wide transition-all duration-500 hover:bg-[#1ebe5b] hover:-translate-y-0.5 hover:shadow-lg hover:shadow-[#25D366]/30">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
              </svg>
              Escríbenos por WhatsApp
            </a>
            <a href="/contacto#ubicacion" class="btn-outline !border-white/30 !text-white hover:!bg-white hover:!text-navy-900">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              Ver ubicación
            </a>
          </div>
        </div>

        <div class="reveal-right grid sm:grid-cols-2 gap-6 lg:gap-8">
          <div class="p-6 md:p-8 rounded-2xl bg-white/5 backdrop-blur-sm border border-white/10">
            <div class="w-12 h-12 rounded-xl bg-olive-600/20 flex items-center justify-center mb-5">
              <svg class="w-6 h-6 text-olive-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <h4 class="font-semibold mb-2 text-lg">Correo corporativo</h4>
            <a href={`mailto:${companyInfo.email}`} class="text-white/70 hover:text-olive-400 transition-colors font-light">
              {companyInfo.email}
            </a>
          </div>
          <div class="p-6 md:p-8 rounded-2xl bg-white/5 backdrop-blur-sm border border-white/10">
            <div class="w-12 h-12 rounded-xl bg-olive-600/20 flex items-center justify-center mb-5">
              <svg class="w-6 h-6 text-olive-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <h4 class="font-semibold mb-2 text-lg">Teléfono</h4>
            <a href={`tel:${companyInfo.phone.replace(/\s/g, '')}`} class="text-white/70 hover:text-olive-400 transition-colors font-light">
              {companyInfo.phone}
            </a>
          </div>
          <div class="p-6 md:p-8 rounded-2xl bg-white/5 backdrop-blur-sm border border-white/10 sm:col-span-2">
            <div class="w-12 h-12 rounded-xl bg-olive-600/20 flex items-center justify-center mb-5">
              <svg class="w-6 h-6 text-olive-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <h4 class="font-semibold mb-2 text-lg">Dirección</h4>
            <p class="text-white/70 font-light">
              {companyInfo.address}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-5 md:px-8 lg:px-12 py-12 md:py-16">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">
      <div class="lg:col-span-2 reveal">
        <div class="flex items-center gap-3 mb-6">
          <img
            src={logoSrc}
            alt="Agro Norte Corp S.A.C."
            class="h-12 w-auto object-contain rounded-lg bg-white p-1 shrink-0"
            width="48"
            height="48"
          />
          <div>
            <h3 class="font-brand text-lg md:text-xl font-bold tracking-[0.04em] uppercase whitespace-nowrap">Agro Norte Corp S.A.C.</h3>
            <p class="text-xs tracking-[0.2em] uppercase text-olive-400 font-semibold">Agricultura sostenible</p>
          </div>
        </div>
        <p class="text-white/60 font-light leading-relaxed max-w-md mb-6">
          Empresa agrícola peruana dedicada al cultivo y producción de Palta Hass y Uva Allison de alta calidad, comprometida con prácticas sostenibles y el bienestar de nuestra gente.
        </p>
        <div class="flex items-center gap-3">
          <a href={companyInfo.social.facebook} target="_blank" rel="noopener" class="w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-white/70 hover:bg-olive-600 hover:text-white hover:border-olive-600 transition-all duration-500">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <a href={companyInfo.social.instagram} target="_blank" rel="noopener" class="w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-white/70 hover:bg-olive-600 hover:text-white hover:border-olive-600 transition-all duration-500">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
          </a>
          <a href={companyInfo.social.linkedin} target="_blank" rel="noopener" class="w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-white/70 hover:bg-olive-600 hover:text-white hover:border-olive-600 transition-all duration-500">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
        </div>
      </div>

      <div class="reveal">
        <h4 class="font-semibold text-lg mb-6">Navegación</h4>
        <ul class="space-y-3">
          <li><a href="/" class="text-white/60 hover:text-olive-400 transition-colors font-light">Inicio</a></li>
          <li><a href="/productos" class="text-white/60 hover:text-olive-400 transition-colors font-light">Productos</a></li>
          <li><a href="/proceso" class="text-white/60 hover:text-olive-400 transition-colors font-light">Proceso</a></li>
          <li><a href="/sostenibilidad" class="text-white/60 hover:text-olive-400 transition-colors font-light">Sostenibilidad</a></li>
          <li><a href="/fundo" class="text-white/60 hover:text-olive-400 transition-colors font-light">Fundo</a></li>
          <li><a href="/noticias" class="text-white/60 hover:text-olive-400 transition-colors font-light">Noticias</a></li>
          <li><a href="/nosotros" class="text-white/60 hover:text-olive-400 transition-colors font-light">Nosotros</a></li>
          <li><a href="/contacto" class="text-white/60 hover:text-olive-400 transition-colors font-light">Contacto</a></li>
        </ul>
      </div>

      <div class="reveal">
        <h4 class="font-semibold text-lg mb-6">Nuestros productos</h4>
        <ul class="space-y-3">
          <li><a href="/productos" class="text-white/60 hover:text-olive-400 transition-colors font-light flex items-center gap-2">
            <span class="text-lg">🥑</span> Palta Hass
          </a></li>
          <li><a href="/productos" class="text-white/60 hover:text-olive-400 transition-colors font-light flex items-center gap-2">
            <span class="text-lg">🍇</span> Uva Allison
          </a></li>
        </ul>
      </div>
    </div>

    <div class="mt-16 pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-white/50 text-sm font-light text-center md:text-left">
        © {new Date().getFullYear()} Agro Norte Corp. Todos los derechos reservados.
      </p>
      <div class="flex items-center gap-6 text-sm">
        <a href="#" class="text-white/50 hover:text-olive-400 transition-colors font-light">Política de privacidad</a>
        <a href="#" class="text-white/50 hover:text-olive-400 transition-colors font-light">Términos y condiciones</a>
      </div>
    </div>
  </div>
</footer>
