---
import { resolveImages } from '../lib/media';
const media = await resolveImages(['logo']);
const logoSrc = media.logo;

const companyInfo = {
  name: 'Agro Norte Corp',
  email: 'informes@agronortecorp.pe',
  phone: '+51 987 654 321',
  address: 'Fundo Agro Norte, La Libertad, Perú',
  social: {
    facebook: '#',
    instagram: '#',
    linkedin: '#'
  }
};

const navLinks = [
  { name: 'Inicio', href: '/' },
  { name: 'Productos', href: '/productos' },
  { name: 'Proceso', href: '/proceso' },
  { name: 'Sostenibilidad', href: '/sostenibilidad' },
  { name: 'Fundo', href: '/fundo' },
  { name: 'Noticias', href: '/noticias' },
  { name: 'Nosotros', href: '/nosotros' },
  { name: 'Contacto', href: '/contacto' }
];
---

<footer class="relative bg-navy-950 text-white">
  <section class="border-b border-white/10">
    <div class="max-w-7xl mx-auto px-5 md:px-8 lg:px-12 py-10 md:py-12">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-8">
        <div class="max-w-xl">
          <h2 class="font-display text-2xl md:text-3xl font-semibold mb-2">
            ¿Quieres conocer más sobre <span class="text-olive-400">Agro Norte Corp</span>?
          </h2>
          <p class="text-white/60 text-sm font-light">
            Escríbenos y conversemos sobre nuestros campos y productos.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="/contacto" class="inline-flex items-center gap-2 px-5 py-2.5 bg-olive-600 hover:bg-olive-500 text-white text-sm font-medium uppercase tracking-wide transition-colors">
            Contáctanos
          </a>
          <a href="https://wa.me/51987654321" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#25D366] hover:bg-[#1ebe5b] text-white text-sm font-medium uppercase tracking-wide transition-colors">
            WhatsApp
          </a>
        </div>
      </div>

      <div class="mt-8 grid sm:grid-cols-3 gap-3">
        <a href={`mailto:${companyInfo.email}`} class="flex items-center gap-3 px-4 py-3 rounded-xl bg-white/5 border border-white/10 hover:border-olive-500/40 transition-colors">
          <span class="w-8 h-8 rounded-lg bg-olive-600/20 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4 text-olive-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </span>
          <span>
            <span class="block text-[11px] uppercase tracking-wider text-white/40">Correo</span>
            <span class="text-sm text-white/80">{companyInfo.email}</span>
          </span>
        </a>
        <a href={`tel:${companyInfo.phone.replace(/\s/g, '')}`} class="flex items-center gap-3 px-4 py-3 rounded-xl bg-white/5 border border-white/10 hover:border-olive-500/40 transition-colors">
          <span class="w-8 h-8 rounded-lg bg-olive-600/20 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4 text-olive-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </span>
          <span>
            <span class="block text-[11px] uppercase tracking-wider text-white/40">Teléfono</span>
            <span class="text-sm text-white/80">{companyInfo.phone}</span>
          </span>
        </a>
        <a href="/contacto#ubicacion" class="flex items-center gap-3 px-4 py-3 rounded-xl bg-white/5 border border-white/10 hover:border-olive-500/40 transition-colors">
          <span class="w-8 h-8 rounded-lg bg-olive-600/20 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4 text-olive-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </span>
          <span>
            <span class="block text-[11px] uppercase tracking-wider text-white/40">Dirección</span>
            <span class="text-sm text-white/80">{companyInfo.address}</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-5 md:px-8 lg:px-12 py-8">
    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-8">
      <div class="max-w-sm">
        <div class="flex items-center gap-2.5 mb-3">
          <img
            src={logoSrc}
            alt="Agro Norte Corp S.A.C."
            class="h-9 w-auto object-contain rounded-md bg-white p-0.5 shrink-0"
            width="36"
            height="36"
          />
          <div>
            <p class="font-brand text-sm font-bold tracking-[0.04em] uppercase">Agro Norte Corp S.A.C.</p>
            <p class="text-[10px] tracking-[0.16em] uppercase text-olive-400 font-semibold">Agricultura sostenible</p>
          </div>
        </div>
        <p class="text-white/50 text-sm font-light leading-relaxed">
          Palta Hass y Uva Allison de alta calidad, con prácticas sostenibles.
        </p>
      </div>

      <nav class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
        {navLinks.map((link) => (
          <a href={link.href} class="text-white/55 hover:text-olive-400 transition-colors font-light">
            {link.name}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-2">
        <a href={companyInfo.social.facebook} target="_blank" rel="noopener" aria-label="Facebook" class="w-8 h-8 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-white/60 hover:bg-olive-600 hover:text-white hover:border-olive-600 transition-colors">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>
        <a href={companyInfo.social.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="w-8 h-8 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-white/60 hover:bg-olive-600 hover:text-white hover:border-olive-600 transition-colors">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
          </svg>
        </a>
        <a href={companyInfo.social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class="w-8 h-8 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-white/60 hover:bg-olive-600 hover:text-white hover:border-olive-600 transition-colors">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
      </div>
    </div>

    <div class="mt-8 pt-5 border-t border-white/10 flex flex-col sm:flex-row justify-between items-center gap-3">
      <p class="text-white/40 text-xs font-light">
        © {new Date().getFullYear()} Agro Norte Corp. Todos los derechos reservados.
      </p>
      <div class="flex items-center gap-5 text-xs">
        <a href="/privacidad" target="_blank" rel="noopener" class="text-white/40 hover:text-olive-400 transition-colors font-light">Política de privacidad</a>
        <a href="#" class="text-white/40 hover:text-olive-400 transition-colors font-light">Términos y condiciones</a>
      </div>
    </div>
  </div>
</footer>
