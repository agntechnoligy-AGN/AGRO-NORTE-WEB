---
export interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  bgImage: string;
}
const { eyebrow, title, subtitle, bgImage } = Astro.props;
---

<section class="relative h-[55vh] md:h-[65vh] min-h-[420px] overflow-hidden flex items-end">
  <div class="absolute inset-0" data-parallax="0.2">
    <img src={bgImage} alt="" class="w-full h-full object-cover" loading="eager"/>
  </div>
  <div class="absolute inset-0 bg-gradient-to-t from-warm-white via-navy-950/30 to-navy-950/70"></div>
  <div class="absolute inset-0 bg-grain mix-blend-overlay pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-5 md:px-8 lg:px-12 w-full pb-14 md:pb-20">
    <div class="max-w-3xl reveal">
      <span class="inline-block px-4 py-1.5 rounded-full bg-olive-500/20 backdrop-blur-sm border border-olive-300/30 text-olive-100 text-[11px] md:text-xs font-bold tracking-[0.25em] uppercase mb-4 md:mb-6">
        {eyebrow}
      </span>
      <h1 class="font-display text-4xl md:text-6xl lg:text-7xl font-bold text-white mb-4 md:mb-6 leading-tight text-balance">
        {title}
      </h1>
      {subtitle && (
        <p class="text-lg md:text-2xl font-light text-white/85 max-w-2xl leading-relaxed text-balance">
          {subtitle}
        </p>
      )}
    </div>
  </div>
</section>
