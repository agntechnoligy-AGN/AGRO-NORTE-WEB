---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ProductStage from '../components/ProductStage.astro';
import { resolveImages } from '../lib/media';
const images = await resolveImages();

const headerImg = images.headerProductos;

const paltaFeatures = [
  { label: 'Variedad', value: 'Hass Premium' },
  { label: 'Origen', value: 'La Libertad, Perú' },
  { label: 'Cosecha', value: 'Abril - Agosto' },
  { label: 'Brix (dulzor)', value: 'Medio - Alto' },
  { label: 'Textura', value: 'Cremosa, untuosa' },
  { label: 'Calibres', value: '12, 14, 16, 18, 20, 22, 24' },
  { label: 'Mercados', value: 'EU, EE.UU., Asia' }
];

const uvaFeatures = [
  { label: 'Variedad', value: 'Allison' },
  { label: 'Origen', value: 'La Libertad, Perú' },
  { label: 'Cosecha', value: 'Enero - Abril' },
  { label: 'Brix (dulzor)', value: 'Alto' },
  { label: 'Textura', value: 'Crujiente y firme' },
  { label: 'Característica', value: 'Sin semilla' },
  { label: 'Mercados', value: 'EU, EE.UU., Asia' }
];

const beneficios = [
  { icon: '🥑', title: 'Palta Hass', items: ['Omega 3 y 6 saludables', 'Más de 20 vitaminas y minerales', 'Alto contenido de fibra', 'Grasas monoinsaturadas buenas'] },
  { icon: '🍇', title: 'Uva Allison', items: ['Antioxidantes naturales', 'Resveratrol (piel)', 'Vitaminas K, C, B6', 'Energía natural y fructosa'] }
];
---

<BaseLayout title="Productos | Agro Norte Corp" description="Palta Hass y Uva Allison de Agro Norte Corp. Producción peruana de exportación.">
  <PageHeader
    eyebrow="Nuestros Productos"
    title="Lo mejor de nuestra tierra"
    subtitle="Palta Hass y Uva Allison. Calidad de exportación cultivada con dedicación en el norte del Perú."
    bgImage={headerImg}
  />

  <section class="relative section-padding bg-gradient-to-b from-warm-white via-cream-50 to-warm-white">
    <div class="max-w-7xl mx-auto px-5 md:px-8 lg:px-12">
      <div class="grid md:grid-cols-2 gap-8 lg:gap-10 mb-20">
        <article class="reveal">
          <ProductStage
            name="Palta Hass"
            cutout="/images/palta-hass.png"
            tone="palta"
            tagline="La variedad rey del mercado internacional"
            description="Piel rugosa que oscurece al madurar, pulpa cremosa y sabor equilibrado. Cultivada en el clima del norte del Perú."
            href="/productos/palta-hass"
            features={[
              { label: 'Textura', desc: 'Cremosa' },
              { label: 'Cosecha', desc: 'Abril – Agosto' },
              { label: 'Calibres', desc: '12 a 24' },
              { label: 'Mercados', desc: 'EU, EE.UU., Asia' }
            ]}
          />
          <div class="mt-5 p-6 md:p-10 bg-white rounded-3xl shadow-xl shadow-navy-900/5">
            <p class="text-navy-700/80 font-light leading-relaxed mb-8 text-lg">
              Nuestra palta Hass se distingue por su piel rugosa color morado oscuro al madurar, su pulpa cremosa de color verde intenso y su sabor equilibrado. Cultivada en terrenos con clima ideal.
            </p>
            <div class="grid sm:grid-cols-2 gap-4">
              {paltaFeatures.map(f => (
                <div class="flex items-center justify-between p-4 rounded-xl bg-olive-50/60 border border-olive-100">
                  <span class="text-xs md:text-sm font-semibold text-navy-800 uppercase tracking-wide">{f.label}</span>
                  <span class="text-sm md:text-base font-bold text-olive-700 text-right">{f.value}</span>
                </div>
              ))}
            </div>
          </div>
        </article>

        <article class="reveal-right" data-delay="100">
          <ProductStage
            name="Uva Allison"
            cutout="/images/uva-allison.png"
            tone="uva"
            tagline="Dulzor, firmeza y calidad de exportación"
            description="Cosechada en el punto óptimo para un racimo uniforme, grano crujiente y dulzor alto en cada envío."
            href="/productos/uva-allison"
            features={[
              { label: 'Textura', desc: 'Crujiente' },
              { label: 'Cosecha', desc: 'Enero – Abril' },
              { label: 'Carácter', desc: 'Sin semilla' },
              { label: 'Mercados', desc: 'EU, EE.UU., Asia' }
            ]}
          />
          <div class="mt-5 p-6 md:p-10 bg-white rounded-3xl shadow-xl shadow-navy-900/5">
            <p class="text-navy-700/80 font-light leading-relaxed mb-8 text-lg">
              Producimos uva Allison de alta calidad, cosechada en el punto óptimo de maduración para garantizar dulzor y textura crujiente en cada envío.
            </p>
            <div class="grid sm:grid-cols-2 gap-4">
              {uvaFeatures.map(f => (
                <div class="flex items-center justify-between p-4 rounded-xl bg-earth-50/60 border border-earth-200">
                  <span class="text-xs md:text-sm font-semibold text-navy-800 uppercase tracking-wide">{f.label}</span>
                  <span class="text-sm md:text-base font-bold text-earth-800 text-right">{f.value}</span>
                </div>
              ))}
            </div>
          </div>
        </article>
      </div>

      <div class="grid md:grid-cols-2 gap-6 lg:gap-8 mb-14">
        {beneficios.map((b, i) => (
          <div class={`${i === 0 ? 'reveal' : 'reveal-right'} p-8 md:p-10 rounded-3xl border border-navy-900/5 bg-white`} data-delay="100">
            <div class="text-5xl mb-5">{b.icon}</div>
            <h3 class="font-display text-3xl font-bold text-navy-900 mb-6">Beneficios {b.title}</h3>
            <ul class="space-y-3">
              {b.items.map(it => (
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-olive-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  <span class="text-navy-700/90 font-light">{it}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="reveal p-8 md:p-12 rounded-3xl bg-gradient-to-br from-olive-700 via-olive-800 to-olive-900 text-white shadow-2xl shadow-olive-900/30">
        <div class="max-w-2xl">
          <h3 class="font-display text-3xl md:text-4xl font-bold mb-3">Sembramos y exportamos</h3>
          <p class="text-white/80 font-light text-lg">Cada cultivo tiene su ficha: origen, temporada y destino de exportación.</p>
        </div>
        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <a href="/productos/palta-hass" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white text-olive-800 font-bold uppercase tracking-wider text-sm hover:bg-olive-100 hover:-translate-y-1 transition-all duration-500">
            Detalles Palta Hass
          </a>
          <a href="/productos/uva-allison" class="inline-flex items-center justify-center gap-2 px-8 py-4 border border-white/40 text-white font-bold uppercase tracking-wider text-sm hover:bg-white/10 hover:-translate-y-1 transition-all duration-500">
            Detalles Uva Allison
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
