---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { resolveImages } from '../lib/media';

const images = await resolveImages(['uva']);
const headerImg = images.uva;

const fieldSteps = [
  {
    num: '01',
    title: 'Preparación del suelo',
    desc: 'Análisis de pH, nutrientes y textura. Arado, nivelación y corrección para dejar el terreno listo en Don Jorge.'
  },
  {
    num: '02',
    title: 'Plantación y cultivo',
    desc: 'Plantas de vivero certificado. Plantación cuidadosa y seguimiento inicial para un enraizamiento uniforme.'
  },
  {
    num: '03',
    title: 'Riego tecnificado',
    desc: 'Goteo programado y sensores de humedad. Uso responsable del agua en palta y uva.'
  },
  {
    num: '04',
    title: 'Monitoreo de campo',
    desc: 'Sanidad vegetal, nutrición y desarrollo fenológico. Visitas diarias y reportes semanales del equipo técnico.'
  }
];

const packingSteps = [
  {
    num: '05',
    title: 'Cosecha selectiva',
    desc: 'Corte en el punto exacto. Brix, color, calibre y firmeza se revisan antes de cosechar cada fruto o racimo.'
  },
  {
    num: '06',
    title: 'Selección y calidad',
    desc: 'Línea óptica y revisión manual. Calibres de exportación y control sanitario según normativa internacional.'
  },
  {
    num: '07',
    title: 'Cadena de frío',
    desc: 'Pre-enfriamiento para uva y cámaras controladas para palta. Temperatura rastreada en todo el recorrido.'
  },
  {
    num: '08',
    title: 'Distribución',
    desc: 'Logística certificada, envíos marítimos y aéreos, y trazabilidad desde el fundo hasta el destino.'
  }
];

const quality = [
  { title: 'HACCP', desc: 'Puntos de control críticos en cada etapa' },
  { title: 'Buenas prácticas', desc: 'BPA y BPM aplicadas en campo y packing' },
  { title: 'Control Brix', desc: 'Dulzor medido por lote cosechado' },
  { title: 'Calibres', desc: 'Clasificación por tamaño de mercado' },
  { title: 'Trazabilidad', desc: 'Lote, fundo y cosecha registrados' },
  { title: 'Laboratorio', desc: 'Pruebas físico-químicas y microbiológicas' }
];
---

<BaseLayout title="Nuestro Proceso | Agro Norte Corp" description="Proceso productivo de Agro Norte Corp: del fundo a la exportación. Ocho etapas para palta Hass y uva de mesa.">
  <PageHeader
    eyebrow="Nuestro proceso"
    title="Del fundo a tu mesa"
    subtitle="Ocho etapas para palta y uva, con el mismo estándar en Don Jorge 1, 2 y 3."
    bgImage={headerImg}
  />

  <section class="relative pb-20 md:pb-28 overflow-hidden">
    <div class="max-w-5xl mx-auto px-5 md:px-8 lg:px-12">
      <div class="text-center mb-14 md:mb-16 reveal">
        <span class="section-label">Cómo trabajamos</span>
        <h2 class="section-title mx-auto max-w-3xl">Un flujo claro, del campo al destino</h2>
      </div>

      <div class="mb-16">
        <p class="text-xs font-semibold tracking-[0.22em] uppercase text-olive-600 mb-8">En el fundo</p>
        <ol class="relative border-l border-olive-200 ml-4 md:ml-5 space-y-8">
          {fieldSteps.map((step, i) => (
            <li class="reveal relative pl-10 md:pl-14" data-delay={i * 50}>
              <span class="absolute -left-[1.15rem] md:-left-[1.35rem] top-0 w-9 h-9 md:w-10 md:h-10 rounded-full bg-olive-700 text-white font-display text-sm font-bold flex items-center justify-center shadow-md shadow-olive-900/20">
                {step.num}
              </span>
              <h3 class="font-display text-2xl md:text-3xl font-semibold text-navy-900 mb-2">{step.title}</h3>
              <p class="text-navy-700/80 font-light leading-relaxed max-w-2xl">{step.desc}</p>
            </li>
          ))}
        </ol>
      </div>

      <div class="mb-20">
        <p class="text-xs font-semibold tracking-[0.22em] uppercase text-olive-600 mb-8">Packing y destino</p>
        <ol class="relative border-l border-olive-200 ml-4 md:ml-5 space-y-8">
          {packingSteps.map((step, i) => (
            <li class="reveal relative pl-10 md:pl-14" data-delay={i * 50}>
              <span class="absolute -left-[1.15rem] md:-left-[1.35rem] top-0 w-9 h-9 md:w-10 md:h-10 rounded-full bg-olive-700 text-white font-display text-sm font-bold flex items-center justify-center shadow-md shadow-olive-900/20">
                {step.num}
              </span>
              <h3 class="font-display text-2xl md:text-3xl font-semibold text-navy-900 mb-2">{step.title}</h3>
              <p class="text-navy-700/80 font-light leading-relaxed max-w-2xl">{step.desc}</p>
            </li>
          ))}
        </ol>
      </div>

      <div class="reveal mb-16">
        <div class="text-center mb-10">
          <span class="section-label">Control de calidad</span>
          <h2 class="section-title mx-auto max-w-3xl">La excelencia es la norma</h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {quality.map((q, i) => (
            <div class="reveal-scale p-5 rounded-2xl bg-white border border-navy-900/5 shadow-sm" data-delay={i * 40}>
              <h4 class="font-semibold text-navy-900 mb-1">{q.title}</h4>
              <p class="text-navy-700/75 font-light text-sm leading-relaxed">{q.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="reveal-scale p-8 md:p-10 rounded-3xl bg-navy-950 text-white flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="max-w-xl">
          <h3 class="font-display text-2xl md:text-3xl font-semibold mb-2">Estándares de exportación</h3>
          <p class="text-white/70 font-light">Procesos alineados con mercados de Europa, Norteamérica y Asia.</p>
        </div>
        <a href="/productos" class="inline-flex items-center gap-2 px-6 py-3 bg-olive-600 hover:bg-olive-500 text-white text-sm font-semibold uppercase tracking-wider transition-colors">
          Ver productos
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
