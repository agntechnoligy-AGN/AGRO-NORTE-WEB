---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { resolveImages } from '../lib/media';
const images = await resolveImages();

const headerImg = images.headerContacto;

const companyInfo = {
  email: 'informes@agronortecorp.pe',
  phone: '+51 987 654 321',
  whatsapp: '51987654321',
  address: 'Fundo Agro Norte, La Libertad, Perú',
  hours: 'Lun – Vie: 8:00 – 17:00'
};

const contactCards = [
  {
    title: 'Correo',
    value: companyInfo.email,
    href: `mailto:${companyInfo.email}`,
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`
  },
  {
    title: 'Teléfono',
    value: companyInfo.phone,
    href: `tel:${companyInfo.phone.replace(/\s/g, '')}`,
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>`
  },
  {
    title: 'WhatsApp',
    value: 'Chatea con nosotros',
    href: `https://wa.me/${companyInfo.whatsapp}`,
    icon: `<svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>`
  },
  {
    title: 'Ubicación',
    value: companyInfo.address,
    href: '#ubicacion',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`
  }
];
---

<BaseLayout title="Contacto | Agro Norte Corp" description="Contáctanos: correo, teléfono, WhatsApp y ubicación del fundo Agro Norte Corp en La Libertad, Perú.">
  <PageHeader
    eyebrow="Contacto"
    title="Hablemos"
    subtitle="Estamos listos para conversar sobre productos, cotizaciones, visitas al fundo o alianzas comerciales."
    bgImage={headerImg}
  />

  <section class="relative section-padding overflow-hidden">
    <div class="max-w-7xl mx-auto px-5 md:px-8 lg:px-12">
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-16 md:mb-20">
        {contactCards.map((c, i) => (
          <a href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel={c.href.startsWith('http') ? 'noopener' : undefined} class="reveal-scale group p-6 rounded-3xl bg-white border border-navy-900/5 shadow-lg shadow-navy-900/5 hover:-translate-y-1 hover:shadow-xl hover:border-olive-200 transition-all duration-500" data-delay={i * 60}>
            <div class="w-12 h-12 rounded-2xl bg-olive-50 text-olive-700 group-hover:bg-olive-700 group-hover:text-white flex items-center justify-center mb-4 transition-colors duration-500">
              <Fragment set:html={c.icon} />
            </div>
            <p class="text-xs uppercase tracking-wider text-olive-700 font-bold mb-1">{c.title}</p>
            <p class="font-semibold text-navy-900 leading-snug">{c.value}</p>
          </a>
        ))}
      </div>

      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-start mb-20">
        <div class="reveal">
          <span class="section-label">Escríbenos</span>
          <h2 class="section-title mb-4">Envíanos tu mensaje</h2>
          <p class="section-subtitle mb-8">
            Completa el formulario y te responderemos a la brevedad. También puedes escribirnos por WhatsApp para una atención más rápida.
          </p>
          <ul class="space-y-4 text-navy-700/90 font-light">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-olive-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              Cotizaciones de palta Hass y uva
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-olive-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              Información de campañas y disponibilidad
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-olive-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              Visitas al fundo y alianzas comerciales
            </li>
          </ul>
          <p class="mt-8 text-sm text-navy-600 font-light">
            Horario de atención: <span class="font-semibold text-navy-900">{companyInfo.hours}</span>
          </p>
        </div>

        <form class="reveal-right p-6 md:p-10 rounded-3xl bg-white border border-navy-900/5 shadow-xl shadow-navy-900/5 space-y-5" data-delay="100" action={`mailto:${companyInfo.email}`} method="GET" enctype="text/plain">
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="nombre" class="block text-xs font-bold uppercase tracking-wider text-navy-800 mb-2">Nombre</label>
              <input id="nombre" name="nombre" type="text" required placeholder="Tu nombre" class="w-full px-4 py-3.5 rounded-xl border border-navy-900/10 bg-cream-50/50 focus:outline-none focus:ring-2 focus:ring-olive-500/40 focus:border-olive-500 transition-all"/>
            </div>
            <div>
              <label for="empresa" class="block text-xs font-bold uppercase tracking-wider text-navy-800 mb-2">Empresa</label>
              <input id="empresa" name="empresa" type="text" placeholder="Tu empresa" class="w-full px-4 py-3.5 rounded-xl border border-navy-900/10 bg-cream-50/50 focus:outline-none focus:ring-2 focus:ring-olive-500/40 focus:border-olive-500 transition-all"/>
            </div>
          </div>
          <div>
            <label for="email" class="block text-xs font-bold uppercase tracking-wider text-navy-800 mb-2">Correo</label>
            <input id="email" name="email" type="email" required placeholder="tu@correo.com" class="w-full px-4 py-3.5 rounded-xl border border-navy-900/10 bg-cream-50/50 focus:outline-none focus:ring-2 focus:ring-olive-500/40 focus:border-olive-500 transition-all"/>
          </div>
          <div>
            <label for="asunto" class="block text-xs font-bold uppercase tracking-wider text-navy-800 mb-2">Asunto</label>
            <select id="asunto" name="asunto" class="w-full px-4 py-3.5 rounded-xl border border-navy-900/10 bg-cream-50/50 focus:outline-none focus:ring-2 focus:ring-olive-500/40 focus:border-olive-500 transition-all">
              <option>Cotización de productos</option>
              <option>Información general</option>
              <option>Visita al fundo</option>
              <option>Alianza comercial</option>
              <option>Otro</option>
            </select>
          </div>
          <div>
            <label for="mensaje" class="block text-xs font-bold uppercase tracking-wider text-navy-800 mb-2">Mensaje</label>
            <textarea id="mensaje" name="mensaje" rows="5" required placeholder="Cuéntanos en qué podemos ayudarte..." class="w-full px-4 py-3.5 rounded-xl border border-navy-900/10 bg-cream-50/50 focus:outline-none focus:ring-2 focus:ring-olive-500/40 focus:border-olive-500 transition-all resize-y"></textarea>
          </div>
          <button type="submit" class="btn-primary w-full justify-center">
            Enviar mensaje
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </button>
          <a href={`https://wa.me/${companyInfo.whatsapp}`} target="_blank" rel="noopener" class="flex items-center justify-center gap-2 w-full px-6 py-3.5 rounded-xl bg-[#25D366] text-white font-bold uppercase tracking-wider text-sm hover:bg-[#1ebe5b] transition-colors">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Preferir WhatsApp
          </a>
        </form>
      </div>

      <div id="ubicacion" class="reveal rounded-3xl overflow-hidden border border-navy-900/5 shadow-xl">
        <div class="p-6 md:p-8 bg-olive-800 text-white">
          <h3 class="font-display text-2xl md:text-3xl font-bold mb-2">Nuestra ubicación</h3>
          <p class="text-olive-100 font-light">{companyInfo.address}</p>
        </div>
        <div class="aspect-[21/9] min-h-[240px] bg-cream-100 flex items-center justify-center">
          <div class="text-center px-6">
            <div class="w-16 h-16 rounded-full bg-olive-100 text-olive-700 flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <p class="font-display text-xl font-bold text-navy-900 mb-2">Fundo Agro Norte</p>
            <p class="text-navy-700/80 font-light">La Libertad, Perú</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
