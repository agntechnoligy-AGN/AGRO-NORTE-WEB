---
import { resolveImages } from '../lib/media';
import ProductStage from '../components/ProductStage.astro';

await resolveImages();

const products = [
  {
    name: 'Palta Hass',
    cutout: '/images/palta-hass.png',
    tone: 'palta' as const,
    tagline: 'Sabor y cremosidad premium',
    description: 'Fruto de piel rugosa y pulpa cremosa, cosechado en su punto para los mercados más exigentes.',
    href: '/productos/palta-hass',
    features: [
      { label: 'Cultivo', desc: 'Cuidado artesanal' },
      { label: 'Calidad', desc: 'Estándar exportación' },
      { label: 'Cosecha', desc: 'Punto óptimo' }
    ]
  },
  {
    name: 'Uva Allison',
    cutout: '/images/uva-allison.png',
    tone: 'uva' as const,
    tagline: 'Dulzura natural del valle',
    description: 'Racimos uniformes, grano crujiente y dulzor alto. Selección manual, grano a grano.',
    href: '/productos/uva-allison',
    features: [
      { label: 'Variedad', desc: 'Allison' },
      { label: 'Textura', desc: 'Crujiente' },
      { label: 'Cosecha', desc: 'Selección manual' }
    ]
  }
];
---

<section id="productos" class="relative section-padding bg-gradient-to-b from-warm-white via-cream-50 to-warm-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-5 md:px-8 lg:px-12 mb-16 md:mb-20 text-center reveal">
    <span class="section-label">Nuestros productos</span>
    <h2 class="section-title mb-6 mx-auto max-w-4xl">
      Lo mejor de <span class="text-olive-700">nuestra tierra</span>
    </h2>
    <p class="section-subtitle mx-auto">
      Dos cultivos seleccionados, producidos con dedicación y los más altos estándares de calidad para llevar a tu mesa el sabor auténtico del norte del Perú.
    </p>
  </div>

  <div class="relative max-w-7xl mx-auto px-5 md:px-8 lg:px-12">
    <div class="grid md:grid-cols-2 gap-6 lg:gap-8">
      {products.map((product, i) => (
        <div class={i === 0 ? 'reveal-left' : 'reveal-right'} data-delay={i * 150}>
          <ProductStage {...product} />
        </div>
      ))}
    </div>
  </div>
</section>
