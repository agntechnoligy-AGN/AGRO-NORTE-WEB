---
import { resolveImages } from '../lib/media';
const images = await resolveImages();

const heroImg = images.greenFields;
const avatars = [images.workers, images.team, images.harvestHands];

const stats = [
  {
    num: '+450',
    title: 'Colaboradores',
    desc: 'Comprometidos con el crecimiento',
    icon: 'people'
  },
  {
    num: '100%',
    title: 'Pasión por el campo',
    desc: 'Nuestra energía en cada proceso',
    icon: 'plant'
  },
  {
    num: '+25%',
    title: 'Productividad',
    desc: 'Resultados que generan futuro',
    icon: 'chart'
  },
  {
    num: 'Todo',
    title: 'A lo correcto',
    desc: 'Integridad en cada paso',
    icon: 'shield'
  }
];

const gallery = [
  { img: images.gallery1, span: 'col-span-1 row-span-1' },
  { img: images.gallery2, span: 'col-span-1 row-span-2' },
  { img: images.gallery3, span: 'col-span-1 row-span-1' },
  { img: images.gallery4, span: 'col-span-1 row-span-1' },
  { img: images.gallery5, span: 'col-span-1 row-span-1' },
  { img: images.gallery6, span: 'col-span-2 md:col-span-2 row-span-1' }
];
---

<section id="nuestra-gente" class="relative section-padding overflow-hidden bg-warm-white">
  <div class="relative max-w-7xl mx-auto px-5 md:px-8 lg:px-12">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center mb-16 md:mb-20">
      <div class="relative reveal">
        <svg class="absolute -right-3 md:-right-8 top-[28%] w-20 md:w-28 h-auto text-olive-500/55 pointer-events-none z-10" viewBox="0 0 120 180" fill="currentColor" aria-hidden="true">
          <path d="M62 8c28 22 48 58 48 92 0 38-22 68-50 80-4-18-6-38-4-58 18-8 30-28 30-50 0-22-14-42-24-64z"/>
          <path d="M58 18C32 42 14 78 14 110c0 36 20 64 46 76 3-16 5-36 3-54C46 124 34 104 34 82c0-22 12-42 24-64z" opacity=".85"/>
          <path d="M60 88v84" stroke="currentColor" stroke-width="6" fill="none" stroke-linecap="round"/>
        </svg>

        <div class="relative rounded-[2rem] overflow-hidden shadow-2xl shadow-navy-900/10 aspect-[5/4]">
          <img src={heroImg} alt="Campos de Agro Norte Corp" class="w-full h-full object-cover" loading="lazy"/>
          <div class="absolute inset-0 bg-gradient-to-tr from-navy-950/25 via-transparent to-transparent"></div>
          <p class="absolute top-8 left-8 font-display italic text-white text-3xl md:text-4xl leading-tight drop-shadow-lg max-w-[12rem]">
            “Cultivando un mejor mañana”
          </p>
        </div>

        <div class="relative z-20 -mt-10 ml-5 md:ml-8 mr-8 md:mr-16 rounded-[1.75rem] bg-white px-5 py-4 shadow-xl shadow-navy-900/10 border border-navy-900/5 flex items-center gap-4">
          <div class="flex -space-x-3 shrink-0">
            {avatars.map((src) => (
              <img src={src} alt="" class="w-11 h-11 rounded-full border-[3px] border-white object-cover object-top" loading="lazy"/>
            ))}
          </div>
          <div>
            <p class="font-bold text-navy-900 leading-tight">+450 colaboradores</p>
            <p class="text-sm text-navy-600 font-light">Comprometidos con la tierra</p>
          </div>
        </div>
      </div>

      <div class="reveal-right" data-delay="80">
        <div class="flex items-center gap-3 mb-4">
          <span class="section-label !mb-0">Nuestra gente</span>
          <span class="h-px w-10 bg-olive-500"></span>
        </div>
        <h2 class="section-title mb-5 text-balance">
          Detrás de cada fruto,<br/>
          <span class="text-olive-700 inline-flex items-center gap-2">
            hay un gran equipo.
            <svg class="w-7 h-7 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 3c4.5 3.2 7.5 8 7.5 12.2 0 4.2-2.4 7.3-5.8 8.8.2-2.4.1-5-.4-7.4 2.2-.8 3.7-3 3.7-5.5 0-2.3-1.4-4.6-2.8-8.1C12.8 5.6 12 4.2 12 3z"/>
              <path d="M12 3C7.5 6.2 4.5 11 4.5 15.2c0 4.2 2.4 7.3 5.8 8.8-.2-2.4-.1-5 .4-7.4C8.5 15.8 7 13.6 7 11.1c0-2.3 1.4-4.6 2.8-8.1C11.2 5.6 12 4.2 12 3z" opacity=".85"/>
            </svg>
          </span>
        </h2>
        <p class="text-navy-700/80 font-light leading-relaxed mb-8 max-w-xl">
          Contamos con un equipo comprometido, especializado y apasionado que día a día trabaja para producir lo mejor de nuestra tierra. Personas con valores, experiencia y dedicación, haciendo posible un futuro más sostenible.
        </p>

        <div class="grid grid-cols-2 gap-3 mb-8">
          {stats.map((s, i) => (
            <div class="p-4 md:p-5 rounded-2xl bg-white border border-navy-900/5 shadow-sm reveal-scale" data-delay={120 + i * 60}>
              {s.icon === 'people' && (
                <svg class="w-6 h-6 text-olive-600 mb-2" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
              )}
              {s.icon === 'plant' && (
                <svg class="w-6 h-6 text-olive-600 mb-2" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19V9m0 0C8 9 5 6 5 3c4 0 7 3 7 6zm0 0c4 0 7-3 7-6-4 0-7 3-7 6zM5 21h14"/></svg>
              )}
              {s.icon === 'chart' && (
                <svg class="w-6 h-6 text-olive-600 mb-2" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 17l6-6 4 4 8-8M13 7h8v8"/></svg>
              )}
              {s.icon === 'shield' && (
                <svg class="w-6 h-6 text-olive-600 mb-2" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              )}
              <p class="font-display text-2xl md:text-3xl font-bold text-olive-700 leading-none mb-1">{s.num}</p>
              <p class="text-sm font-semibold text-navy-900">{s.title}</p>
              <p class="text-xs text-navy-600 font-light mt-0.5">{s.desc}</p>
            </div>
          ))}
        </div>

        <div class="flex flex-wrap items-center gap-5">
          <a href="/contacto" class="btn-primary !bg-olive-800 hover:!bg-olive-900 rounded-full">
            Únete a nuestro equipo
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <div class="flex items-center gap-4">
            <span class="hidden sm:block w-px h-10 bg-navy-900/15"></span>
            <p class="text-sm text-navy-700/70 font-light italic leading-snug">
              Personas que cultivan<br/>un futuro mejor
            </p>
            <span class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-olive-300"></span>
              <span class="w-2 h-2 rounded-full bg-olive-500"></span>
              <span class="w-2 h-2 rounded-full bg-olive-700"></span>
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="reveal-scale" data-delay="200">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 auto-rows-[200px] md:auto-rows-[260px]">
        {gallery.map((g, i) => (
          <div class={`${g.span} image-mask relative rounded-2xl overflow-hidden group shadow-lg shadow-navy-900/5 cursor-pointer`}>
            <img src={g.img} alt="Gente Agro Norte Corp" class="w-full h-full object-cover" loading="lazy"/>
            <div class="absolute inset-0 bg-gradient-to-t from-navy-950/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
            <div class="absolute top-4 right-4 w-10 h-10 rounded-full bg-white/0 group-hover:bg-white flex items-center justify-center transition-all duration-500 opacity-0 group-hover:opacity-100">
              <svg class="w-4 h-4 text-navy-900" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<section id="noticias" class="relative section-padding bg-gradient-to-b from-warm-white via-cream-50 to-warm-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-5 md:px-8 lg:px-12 mb-12 md:mb-16 flex flex-col md:flex-row md:items-end md:justify-between gap-6 reveal">
    <div>
      <span class="section-label">Noticias</span>
      <h2 class="section-title max-w-3xl">
        Entérate de nuestras <span class="text-olive-700">últimas novedades</span>
      </h2>
    </div>
    <a href="/noticias" class="btn-outline self-start md:self-end">
      Ver todas las noticias
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
      </svg>
    </a>
  </div>

  <div class="max-w-7xl mx-auto px-5 md:px-8 lg:px-12 grid md:grid-cols-3 gap-6 lg:gap-8">
    {[
      {
        tag: 'Campaña',
        date: '15 Marzo, 2026',
        title: 'Inicio de campaña de palta Hass 2026',
        excerpt: 'Comenzamos una nueva temporada con expectativas de cosecha record. La calidad promete ser excepcional esta temporada.',
        img: images.newsPalta
      },
      {
        tag: 'Exportación',
        date: '28 Enero, 2026',
        title: 'Comenzamos nuestra campaña de uva de exportación',
        excerpt: 'Nuestras primeras cajas de uva Allison se preparan para mercados de Europa, Asia y América del Norte.',
        img: images.newsUva
      },
      {
        tag: 'Innovación',
        date: '10 Enero, 2026',
        title: 'Implementamos monitoreo digital en tiempo real',
        excerpt: 'Comprometidos con el medio ambiente y la innovación: nuevas estaciones meteorológicas y sensores IoT en todo el fundo.',
        img: images.newsTech
      }
    ].map((news, i) => (
      <article
        class={`reveal group relative rounded-3xl overflow-hidden bg-white border border-navy-900/5 shadow-lg shadow-navy-900/5 hover:shadow-2xl hover:shadow-olive-900/10 transition-all duration-700 hover:-translate-y-2 cursor-pointer flex flex-col`}
        data-delay={i * 120}
      >
        <div class="relative aspect-[16/10] overflow-hidden">
          <img src={news.img} alt={news.title} class="w-full h-full object-cover transition-transform duration-[1500ms] group-hover:scale-110" loading="lazy"/>
          <div class="absolute top-4 left-4 flex items-center gap-2">
            <span class="px-3.5 py-1.5 rounded-full bg-olive-700 text-white text-[11px] font-bold tracking-[0.12em] uppercase">
              {news.tag}
            </span>
          </div>
        </div>
        <div class="flex-1 flex flex-col p-6 md:p-7">
          <div class="flex items-center gap-2 text-xs text-navy-600 font-medium mb-4">
            <svg class="w-4 h-4 text-olive-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            {news.date}
          </div>
          <h3 class="font-display text-xl md:text-2xl font-bold text-navy-900 mb-4 leading-tight group-hover:text-olive-700 transition-colors duration-300">
            {news.title}
          </h3>
          <p class="text-navy-700/80 font-light leading-relaxed mb-6 flex-1">
            {news.excerpt}
          </p>
          <a href="#" class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-olive-700 group-hover:text-olive-800 transition-colors mt-auto">
            Leer más
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
      </article>
    ))}
  </div>
</section>
