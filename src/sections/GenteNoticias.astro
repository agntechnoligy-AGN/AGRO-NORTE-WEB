---
import { resolveImages } from '../lib/media';
const images = await resolveImages();

const heroImg = images.workers;

const gallery = [
  { img: images.gallery1, span: 'col-span-1 row-span-1' },
  { img: images.gallery2, span: 'col-span-1 row-span-2' },
  { img: images.gallery3, span: 'col-span-1 row-span-1' },
  { img: images.gallery4, span: 'col-span-1 row-span-1' },
  { img: images.gallery5, span: 'col-span-1 row-span-1' },
  { img: images.gallery6, span: 'col-span-2 md:col-span-2 row-span-1' }
];
---

<section id="nuestra-gente" class="relative section-padding overflow-hidden bg-warm-white">
  <div class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-l from-olive-50 to-transparent pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-5 md:px-8 lg:px-12">
    <div class="grid lg:grid-cols-5 gap-10 lg:gap-16 items-center mb-16 md:mb-20">
      <div class="lg:col-span-2 reveal">
        <div class="image-mask relative rounded-3xl overflow-hidden shadow-2xl shadow-navy-900/10 aspect-[4/3]">
          <img src={heroImg} alt="Equipo de Agro Norte Corp" class="w-full h-full object-cover" loading="lazy"/>
          <div class="absolute inset-0 bg-gradient-to-tr from-navy-950/20 to-transparent pointer-events-none"></div>
        </div>
        <div class="relative -mt-8 ml-4 md:ml-8 -mr-4 md:-mr-12 rounded-2xl bg-white p-5 md:p-6 shadow-xl shadow-navy-900/10 max-w-sm border border-navy-900/5">
          <div class="flex items-center gap-4 mb-3">
            <div class="flex -space-x-3">
              {['bg-olive-400','bg-earth-400','bg-olive-600'].map((c) => (
                <div class={`w-10 h-10 rounded-full border-2 border-white ${c}`}></div>
              ))}
            </div>
            <div>
              <p class="font-bold text-navy-900">+450 colaboradores</p>
              <p class="text-xs text-navy-600 font-light">Comprometidos con la excelencia</p>
            </div>
          </div>
          <div class="w-full h-2 rounded-full bg-navy-100 overflow-hidden">
            <div class="h-full w-[85%] bg-gradient-to-r from-olive-500 to-olive-400 rounded-full"></div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-3 reveal-right" data-delay="100">
        <span class="section-label">Nuestra gente</span>
        <h2 class="section-title mb-6 md:mb-8 text-balance">
          Detrás de cada fruto,<br/>
          <span class="text-olive-700 font-display italic">hay un gran equipo.</span>
        </h2>
        <p class="section-subtitle mb-10">
          Contamos con un equipo comprometido, especializado y apasionado que día a día trabaja para producir lo mejor de nuestra tierra. Personas con valores, experiencia y dedicación.
        </p>
        <div class="grid sm:grid-cols-3 gap-5 mb-10">
          {[
            { num: '100%', label: 'Personal capacitado' },
            { num: '+25%', label: 'Personal técnico' },
            { num: 'Todo', label: 'Año completo' }
          ].map((s, i) => (
            <div class="p-5 rounded-2xl bg-white border border-navy-900/5 shadow-sm reveal-scale" data-delay={200 + i * 80}>
              <p class="font-display text-3xl md:text-4xl font-bold text-olive-700 mb-1">{s.num}</p>
              <p class="text-sm text-navy-700 font-light leading-snug">{s.label}</p>
            </div>
          ))}
        </div>
        <a href="/contacto" class="btn-primary">
          Únete a nuestro equipo
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>

    <div class="reveal-scale" data-delay="200">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 auto-rows-[200px] md:auto-rows-[260px]">
        {gallery.map((g, i) => (
          <div class={`${g.span} image-mask relative rounded-2xl overflow-hidden group shadow-lg shadow-navy-900/5 cursor-pointer`}>
            <img src={g.img} alt="Gente Agro Norte Corp" class="w-full h-full object-cover" loading="lazy"/>
            <div class="absolute inset-0 bg-gradient-to-t from-navy-950/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
            <div class="absolute top-4 right-4 w-10 h-10 rounded-full bg-white/0 group-hover:bg-white flex items-center justify-center transition-all duration-500 opacity-0 group-hover:opacity-100">
              <svg class="w-4 h-4 text-navy-900" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<section id="noticias" class="relative section-padding bg-gradient-to-b from-warm-white via-cream-50 to-warm-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-5 md:px-8 lg:px-12 mb-12 md:mb-16 flex flex-col md:flex-row md:items-end md:justify-between gap-6 reveal">
    <div>
      <span class="section-label">Noticias</span>
      <h2 class="section-title max-w-3xl">
        Entérate de nuestras <span class="text-olive-700">últimas novedades</span>
      </h2>
    </div>
    <a href="/noticias" class="btn-outline self-start md:self-end">
      Ver todas las noticias
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
      </svg>
    </a>
  </div>

  <div class="max-w-7xl mx-auto px-5 md:px-8 lg:px-12 grid md:grid-cols-3 gap-6 lg:gap-8">
    {[
      {
        tag: 'Campaña',
        date: '15 Marzo, 2026',
        title: 'Inicio de campaña de palta Hass 2026',
        excerpt: 'Comenzamos una nueva temporada con expectativas de cosecha record. La calidad promete ser excepcional esta temporada.',
        img: images.newsPalta
      },
      {
        tag: 'Exportación',
        date: '28 Enero, 2026',
        title: 'Comenzamos nuestra campaña de uva de exportación',
        excerpt: 'Nuestras primeras cajas de uva Allison se preparan para mercados de Europa, Asia y América del Norte.',
        img: images.newsUva
      },
      {
        tag: 'Innovación',
        date: '10 Enero, 2026',
        title: 'Implementamos monitoreo digital en tiempo real',
        excerpt: 'Comprometidos con el medio ambiente y la innovación: nuevas estaciones meteorológicas y sensores IoT en todo el fundo.',
        img: images.newsTech
      }
    ].map((news, i) => (
      <article
        class={`reveal group relative rounded-3xl overflow-hidden bg-white border border-navy-900/5 shadow-lg shadow-navy-900/5 hover:shadow-2xl hover:shadow-olive-900/10 transition-all duration-700 hover:-translate-y-2 cursor-pointer flex flex-col`}
        data-delay={i * 120}
      >
        <div class="relative aspect-[16/10] overflow-hidden">
          <img src={news.img} alt={news.title} class="w-full h-full object-cover transition-transform duration-[1500ms] group-hover:scale-110" loading="lazy"/>
          <div class="absolute top-4 left-4 flex items-center gap-2">
            <span class="px-3.5 py-1.5 rounded-full bg-olive-700 text-white text-[11px] font-bold tracking-[0.12em] uppercase">
              {news.tag}
            </span>
          </div>
        </div>
        <div class="flex-1 flex flex-col p-6 md:p-7">
          <div class="flex items-center gap-2 text-xs text-navy-600 font-medium mb-4">
            <svg class="w-4 h-4 text-olive-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            {news.date}
          </div>
          <h3 class="font-display text-xl md:text-2xl font-bold text-navy-900 mb-4 leading-tight group-hover:text-olive-700 transition-colors duration-300">
            {news.title}
          </h3>
          <p class="text-navy-700/80 font-light leading-relaxed mb-6 flex-1">
            {news.excerpt}
          </p>
          <a href="#" class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-olive-700 group-hover:text-olive-800 transition-colors mt-auto">
            Leer más
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
      </article>
    ))}
  </div>
</section>
