---
import { resolveImages } from '../lib/media';
const images = await resolveImages();

const fundos = [
  {
    code: 'DJ01',
    title: 'Don Jorge 1',
    img: images.greenFields,
    desc: 'Campo con producción combinada de palta Hass y uva de mesa para exportación.',
    crops: [
      { name: 'Palta', icon: '🥑' },
      { name: 'Uva', icon: '🍇' }
    ]
  },
  {
    code: 'DJ02',
    title: 'Don Jorge 2',
    img: images.vineyard,
    desc: 'Segundo fundo con palta y uva, operado con el mismo estándar de calidad y trazabilidad.',
    crops: [
      { name: 'Palta', icon: '🥑' },
      { name: 'Uva', icon: '🍇' }
    ]
  },
  {
    code: 'DJ03',
    title: 'Don Jorge 3',
    img: images.avocadoOrchard,
    desc: 'Fundo dedicado exclusivamente a palta Hass, con huertos seleccionados de alta calidad.',
    crops: [
      { name: 'Palta', icon: '🥑' }
    ]
  }
];
---

<section id="fundo" class="relative section-padding overflow-hidden bg-gradient-to-b from-warm-white to-cream-100">
  <div class="max-w-7xl mx-auto px-5 md:px-8 lg:px-12 mb-12 md:mb-16 reveal">
    <div class="text-center">
      <span class="section-label">Nuestros fundos</span>
      <h2 class="section-title mx-auto max-w-3xl">
        Recorre <span class="text-olive-700">nuestros campos</span>
      </h2>
    </div>
  </div>

  <div class="relative max-w-[1800px] mx-auto reveal-scale">
    <div class="fundo-track flex lg:grid lg:grid-cols-3 gap-5 md:gap-6 px-5 md:px-8 lg:px-12 pb-8 overflow-x-auto lg:overflow-visible scrollbar-hide snap-x snap-mandatory">
      {fundos.map((item, i) => (
        <article
          class="group relative flex-shrink-0 w-[85%] sm:w-[70%] md:w-[52%] lg:w-auto aspect-[4/3] rounded-[2rem] overflow-hidden snap-start shadow-xl shadow-navy-900/10 hover:shadow-2xl hover:shadow-olive-900/20 transition-all duration-700 hover:-translate-y-2"
          style={{animationDelay: `${i * 80}ms`}}
        >
          <img
            src={item.img}
            alt={`${item.title} - Fundo Agro Norte Corp`}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1500ms] ease-out group-hover:scale-110"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-navy-950 via-navy-950/45 to-navy-950/10"></div>

          <div class="absolute top-5 left-5 right-5 flex items-start justify-between gap-3">
            <span class="inline-flex items-center px-3.5 py-1.5 rounded-full bg-white/15 backdrop-blur-md border border-white/25 text-white text-xs tracking-[0.22em] font-bold">
              {item.code}
            </span>
            <div class="flex -space-x-2">
              {item.crops.map((crop) => (
                <span class="w-10 h-10 rounded-2xl bg-white/15 backdrop-blur-md border border-white/25 flex items-center justify-center text-xl shadow-lg">
                  {crop.icon}
                </span>
              ))}
            </div>
          </div>

          <div class="absolute bottom-0 left-0 right-0 p-5 md:p-7 text-white">
            <p class="text-xs tracking-[0.18em] uppercase font-semibold text-olive-300 mb-2">
              Fundo {item.code}
            </p>
            <h3 class="font-display text-3xl md:text-4xl font-bold mb-4">
              {item.title}
            </h3>

            <div class="flex flex-wrap gap-2 mb-4">
              {item.crops.map((crop) => (
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-olive-500/25 border border-olive-200/30 text-sm font-semibold text-olive-100">
                  <span>{crop.icon}</span>
                  {crop.name}
                </span>
              ))}
            </div>

            <p class="text-white/80 font-light text-sm md:text-base leading-relaxed max-w-sm">
              {item.desc}
            </p>
          </div>
        </article>
      ))}
    </div>

    <div class="flex items-center justify-between mt-2 lg:mt-8 max-w-7xl mx-auto px-5 md:px-8 lg:px-12 lg:hidden">
      <p class="text-sm text-navy-700/60 font-light">
        <span class="font-semibold text-navy-800">← Desliza</span> para ver los 3 fundos
      </p>
      <div class="flex items-center gap-2">
        <button id="fundo-prev" class="w-11 h-11 rounded-full bg-white border border-navy-900/10 text-navy-800 hover:bg-olive-700 hover:text-white hover:border-olive-700 transition-all duration-300 flex items-center justify-center shadow-md shadow-navy-900/5">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>
        <button id="fundo-next" class="w-11 h-11 rounded-full bg-white border border-navy-900/10 text-navy-800 hover:bg-olive-700 hover:text-white hover:border-olive-700 transition-all duration-300 flex items-center justify-center shadow-md shadow-navy-900/5">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <script>
    const track = document.querySelector<HTMLElement>('.fundo-track');
    const prevBtn = document.getElementById('fundo-prev');
    const nextBtn = document.getElementById('fundo-next');

    function scrollCard(direction: number) {
      if (!track) return;
      const card = track.querySelector<HTMLElement>('article');
      const scrollAmount = (card?.offsetWidth || 400) + 24;
      track.scrollBy({ left: scrollAmount * direction, behavior: 'smooth' });
    }

    prevBtn?.addEventListener('click', () => scrollCard(-1));
    nextBtn?.addEventListener('click', () => scrollCard(1));
  </script>
</section>
