---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ScrollReveal from '../components/ScrollReveal.astro';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Agro Norte Corp - Cultivamos calidad. Producimos futuro. Empresa agrícola dedicada a la producción de Palta Hass y Uva Allison de alta calidad.' } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#48612f" />
    <link rel="icon" type="image/png" href="/images/logo-agn.png" />
    <link rel="apple-touch-icon" href="/images/logo-agn.png" />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <ScrollReveal />
  </body>
</html>
