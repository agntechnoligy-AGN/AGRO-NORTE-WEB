# Copia este archivo a .env y completa los valores.
# Nunca subas .env al repositorio.

# URL pública de Railway (para desarrollo local)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/railway

# Sesión del panel admin (cambia esto por un string largo aleatorio)
ADMIN_SESSION_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# Usuario admin inicial (se crea en el seed si no existe)
ADMIN_EMAIL=admin@agronortecorp.pe
ADMIN_PASSWORD=cambia-esta-clave
